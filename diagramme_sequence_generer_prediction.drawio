        </mxCell>
        <mxCell id="m24" value="24. &lt;i&gt;run_segmentation_on_files(mri_files, model_key, threshold)&lt;/i&gt;" style="endArrow=block;html=1;rounded=0;fontSize=10;" edge="1" parent="1">
