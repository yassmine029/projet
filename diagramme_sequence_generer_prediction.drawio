            <mxPoint x="1120" y="928" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m23" value="23. Retour instance &lt;i&gt;run&lt;/i&gt; (id, status=running)" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;" edge="1" parent="1">
