        </mxCell>
        <mxCell id="m22" value="22. ORM : &lt;i&gt;SegmentationRun.objects.create(status='running', …)&lt;/i&gt;&lt;br&gt;SQL : &lt;i&gt;INSERT&lt;/i&gt; dans &lt;i&gt;segmentation_run&lt;/i&gt;" style="endArrow=block;html=1;rounded=0;fontSize=10;" edge="1" parent="1">
