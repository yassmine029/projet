        <mxCell id="m32" value="32. &lt;b&gt;400 / 500&lt;/b&gt; JSON erreur vers le React" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="562" y="1299" as="sourcePoint" />
            <mxPoint x="255" y="1299" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Phase F opt -->
        <mxCell id="phaseF" value="&lt;b&gt;Phase F — opt : détail du run (affichage enrichi)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="1330" width="1165" height="22" as="geometry" />
        </mxCell>
        <mxCell id="m33" value="33. Médecin : ouvrir le détail des résultats" style="endArrow=block;html=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="75" y="1370" as="sourcePoint" />
            <mxPoint x="255" y="1370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m34" value="34. &lt;b&gt;GET /segmentation-runs/{run_id}/&lt;/b&gt;" style="endArrow=block;html=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="255" y="1396" as="sourcePoint" />
            <mxPoint x="432" y="1396" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m35" value="35. &lt;i&gt;segmentation_run_detail()&lt;/i&gt;" style="endArrow=block;html=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="432" y="1420" as="sourcePoint" />
            <mxPoint x="562" y="1420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m36" value="36. ORM : chargement run + &lt;i&gt;results&lt;/i&gt; — SQL &lt;i&gt;SELECT&lt;/i&gt; + jointures / prefetch" style="endArrow=block;html=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="562" y="1450" as="sourcePoint" />
            <mxPoint x="1120" y="1450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m37" value="37. Retour lignes" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1120" y="1474" as="sourcePoint" />
            <mxPoint x="562" y="1474" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m38" value="38. &lt;b&gt;200 OK&lt;/b&gt; JSON &lt;i&gt;run&lt;/i&gt; sérialisé + masques" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="562" y="1498" as="sourcePoint" />
            <mxPoint x="255" y="1498" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m39" value="39. &lt;i&gt;setPersistedResults&lt;/i&gt;, &lt;i&gt;setShowResults&lt;/i&gt; — affichage UI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;fontSize=9;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="180" y="1515" width="380" height="26" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Légende&lt;/b&gt; : même logique que le diagramme d’inscription — &lt;b&gt;Router&lt;/b&gt; = urls.py, &lt;b&gt;View&lt;/b&gt; = views.py, &lt;b&gt;Service&lt;/b&gt; = pipeline ONNX (remplace Email), &lt;b&gt;Model&lt;/b&gt; = entités ORM liées à la segmentation, &lt;b&gt;PostgreSQL&lt;/b&gt; = persistance. Les cadres &lt;b&gt;alt&lt;/b&gt;/&lt;b&gt;loop&lt;/b&gt;/&lt;b&gt;opt&lt;/b&gt; reprennent les fragments UML." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="1555" width="1165" height="72" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
