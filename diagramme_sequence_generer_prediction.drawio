          </mxGeometry>
        </mxCell>

        <!-- Phase C-D -->
        <mxCell id="phaseC" value="&lt;b&gt;Phase C — Lancement (données valides + authentifié)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="772" width="1165" height="22" as="geometry" />
