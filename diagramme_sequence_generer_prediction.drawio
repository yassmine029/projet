          <mxGeometry relative="1" as="geometry">
            <mxPoint x="737" y="1088" as="sourcePoint" />
            <mxPoint x="562" y="1088" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m27" value="27. &lt;i&gt;transaction.atomic()&lt;/i&gt; : &lt;i&gt;SegmentationMaskResult.objects.create&lt;/i&gt; (par coupe)&lt;br&gt;SQL : &lt;i&gt;INSERT&lt;/i&gt; dans &lt;i&gt;segmentation_mask_result&lt;/i&gt;" style="endArrow=block;html=1;rounded=0;fontSize=10;" edge="1" parent="1">
