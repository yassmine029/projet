            <mxPoint x="562" y="952" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="loop_frame" value="&lt;b&gt;loop&lt;/b&gt; [pour chaque MRIFile sélectionné]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;dashed=1;dashPattern=8 8;" vertex="1" parent="1">
