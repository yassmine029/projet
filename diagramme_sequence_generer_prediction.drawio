        <mxCell id="m18" value="18. &lt;b&gt;POST /patients/{id}/segment/&lt;/b&gt; body JSON &lt;i&gt;{ model, file_ids, threshold }&lt;/i&gt;" style="endArrow=block;html=1;rounded=0;fontSize=10;" edge="1" parent="1">
