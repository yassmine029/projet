        <mxCell id="m31" value="31. &lt;i&gt;run.save&lt;/i&gt; status=&lt;i&gt;failed&lt;/i&gt;, error_message — SQL &lt;i&gt;UPDATE segmentation_run&lt;/i&gt;" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#b85450;" edge="1" parent="1">
