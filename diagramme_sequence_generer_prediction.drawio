        <mxCell id="m20" value="20. ORM : &lt;i&gt;get_object_or_404(Patient, …)&lt;/i&gt; + &lt;i&gt;MRIFile.objects.filter(…)&lt;/i&gt;&lt;br&gt;SQL : &lt;i&gt;SELECT&lt;/i&gt; patient + fichiers" style="endArrow=block;html=1;rounded=0;fontSize=10;" edge="1" parent="1">
