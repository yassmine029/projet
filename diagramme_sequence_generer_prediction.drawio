            <mxPoint x="737" y="1012" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m25" value="25. Interne IA : lecture image (OpenCV) → tenseur → &lt;i&gt;session.run&lt;/i&gt; ONNX → post-traitement + seuil → PNG masque + storage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;fontSize=9;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1035" width="1125" height="40" as="geometry" />
        </mxCell>
