@startuml VisionMed_Authentification_Flux_Reel
' Diagramme aligne sur le code : session Django + cookie (withCredentials), pas JWT.
' Front : Login.jsx, api.js | Back : views.login_view, views.emergency_login
skinparam sequenceMessageAlign center
skinparam BoxPadding 10

title FIGURE - Diagramme de sequence Authentification (code actuel)\nSession Django + PostgreSQL — VisionMed / NeuroScan

actor "Medecin" as Doc

box "FrontEnd React" #LightBlue
  participant "Login.jsx" as LJ
  participant "api.js\n(axios baseURL /api)" as API
end box

box "BackEnd Django" #MistyRose
  participant "login_view\n(views.py)" as LV
  participant "authenticate()\n(django.contrib.auth)" as AUTH
end box

box "Donnees" #LightGreen
  participant "User\n(django.contrib.auth.models)" as UM
  database "PostgreSQL" as PG
end box

== Connexion standard POST /api/login ==

Doc -> LJ : soumettre formulaire (email, mot de passe)\nhandleSignIn()
opt [isBlocked == true depuis localStorage]
  LJ -> LJ : return (aucun appel reseau)
end

LJ -> LJ : validateEmail(username)\nvalidation locale
LJ -> API : login(username, password)
API -> LV : POST /login\nJSON { username, password }\nwithCredentials: true

LV -> LV : json.loads(request.body)
opt [username ou password vides]
  LV --> API : HTTP 400\n{ ok:false, error: "email et mot de passe requis" }
  API --> LJ : Axios response / catch
end

LV -> UM : User.objects.filter\n(Q(username)|Q(email__iexact)).first()
UM -> PG : SELECT utilisateur
PG --> UM : ligne ou vide
UM --> LV : account ou None

alt [account introuvable]
  LV --> API : HTTP 401\n{ ok:false, error_type: "user_not_found",\nerror: "Compte introuvable" }
  API --> LJ : response
  LJ -> LJ : setEmailError(errMsg)
else [account trouve]
  LV -> AUTH : authenticate(request,\nusername=account.username, password)
  AUTH -> UM : verification hash mot de passe
  UM -> PG : lecture hash / comparaison
  PG --> AUTH
  AUTH --> LV : user ou None

  alt [mot de passe invalide]
    LV --> API : HTTP 401\n{ ok:false, error_type: "invalid_password",\nerror: "Mot de passe incorrect" }
    API --> LJ : response
    LJ -> LJ : increment loginAttempts\nlocalStorage login_attempts
    opt [loginAttempts >= 3]
      LJ -> LJ : setIsBlocked(true)\nlogin_blocked_until (30 min)
    end
  else [authentification OK]
    LV -> LV : login(request, user)\nsession Django + cookie
    LV --> API : HTTP 200\n{ ok:true, message, user: username }
    API --> LJ : response
    LJ -> LJ : onLogin(user)\nredirection /
  end
end

newpage

actor "Medecin" as Doc2

box "FrontEnd React" #LightBlue
  participant "EmergencyLoginPage.jsx" as EL
  participant "api.js" as API2
end box

box "BackEnd Django" #MistyRose
  participant "emergency_login\n(views.py)" as EV
end box

box "Donnees" #LightGreen
  participant "EmergencyLoginAttempt\n(models.py)" as ELA
  participant "User" as UM2
  database "PostgreSQL" as PG2
end box

== Connexion urgence POST /api/emergency_login ==

Doc2 -> EL : soumettre email professionnel
EL -> API2 : emergencyLogin(email)\nPOST /emergency_login { email }
API2 -> EV : requete HTTP + cookie

EV -> EV : json.loads(request.body)
EV -> UM2 : User.objects.filter\n(Q(username)|Q(email__iexact)).first()
UM2 -> PG2 : SELECT
PG2 --> UM2
UM2 --> EV : user ou None

alt [utilisateur absent]
  EV --> API2 : HTTP 404\n{ ok:false, error: "..." }
else [utilisateur present]
  EV -> ELA : get_or_create(email=email)
  ELA -> PG2 : SELECT / INSERT
  PG2 --> ELA
  alt [attempt.count >= 5]
    EV --> API2 : HTTP 403\nLimite acces urgence
  else [count < 5]
    EV -> ELA : count += 1 ; save()
    ELA -> PG2 : UPDATE
    EV -> EV : login(request, user)
    EV --> API2 : HTTP 200\n{ ok:true, user, count, message }
  end
end
API2 --> EL : response

@enduml
